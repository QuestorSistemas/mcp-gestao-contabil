# Configuração do servidor MCP - Questor Gestão Contábil (nHttp)
# Copie este arquivo para .env e preencha com seus dados.

# ── Conexão padrão (obrigatória) ─────────────────────────────────────────────
GC_BASE_URL=http://localhost:8080
GC_LOGON_NAME=administrador@questor
GC_PASSWORD=masterkey

# ── Suporte a múltiplas conexões ─────────────────────────────────────────────
# false (padrão): apenas a conexão "default" é permitida.
# true: permite usar conexao="nome" nos tools e registrar novas conexões
#       via gc_conexao_adicionar.
GC_ALLOW_MULTI_CONN=false

# ── Pasta de downloads ───────────────────────────────────────────────────────
# Onde relatórios, exportações NLI e outros arquivos são salvos.
# Padrão: ~/Downloads/gestao-contabil
GC_DOWNLOAD_DIR=C:\Users\SeuUsuario\Downloads\gestao-contabil

# ── Validação de certificado TLS ─────────────────────────────────────────────
# false (padrão): não valida o certificado. A Cloud Questor fica atrás de um
#       proxy nginx cujo certificado o httpx não valida, e o nHttp local é http puro.
# true: valida normalmente. Use onde o certificado for válido.
GC_VERIFY_SSL=false

# ── Circuit breaker ──────────────────────────────────────────────────────────
# O nHttp trava quando o worker nWebExe engasga; depois disso toda chamada
# apenas espera o timeout inteiro antes de falhar. Após N falhas de rede
# seguidas, o MCP passa a recusar na hora, por alguns segundos.
# GC_BREAKER_FALHAS=3
# GC_BREAKER_ESPERA=60

# ── Conexões adicionais pré-configuradas (requer GC_ALLOW_MULTI_CONN=true) ───
# Substitua {nome} pelo identificador da conexão (ex: filial2, empresa_sp).
# GC_CONN_{NOME}_BASE_URL=http://seu-servidor:8080
# GC_CONN_{NOME}_LOGON_NAME=admin@empresa2
# GC_CONN_{NOME}_PASSWORD=senha2
